// -------- Blynk Credentials -------- 
#define BLYNK_TEM 
PLATE_ID "TMPL3mH34WSPz" 
#define BLYNK_TEMPLATE_NAME "Lawn Sprinkler" 
#define BLYNK_AUTH_TOKEN "YOUR_BLYNK_TOKEN" 
#define BLYNK_PRINT Serial 
#include <ESP8266WiFi.h> 
#include <BlynkSimpleEsp8266.h> 
#include <Servo.h> 
// -------- WiFi -------- char ssid[] = "projectece3"; char pass[] = "projectece3"; 
// -------- PIN DEFINITIONS -------- 
#define SOIL_PIN     D5 
#define RELAY_PIN    D7 
#define SERVO_PIN    D6 
// -------- SERVO ANGLES -------- 
#define SERVO_LEFT    0 
#define SERVO_CENTER  90 
#define SERVO_RIGHT   180 
// -------- Blynk Virtual Pins -------- 
#define VP_PUMP     V0 
#define VP_MODE     V1 
#define VP_LEFT     V2 
#define VP_CENTER   V3 
#define VP_RIGHT    V4 #define VP_SOIL     V5 
// -------- Variables -------- bool autoMode = true; bool manualPump = false; int servoPosition = SERVO_CENTER; 
Servo sprinkler; 
BlynkTimer timer; 
// -------- Manual Pump Control -------- 
BLYNK_WRITE(VP_PUMP) { 
  manualPump = param.asInt();   if (!autoMode) {     digitalWrite(RELAY_PIN, manualPump); 
  } 
} 
// -------- Direction Buttons -------- 
BLYNK_WRITE(VP_LEFT) { 
  if (!autoMode && param.asInt()) {     servoPosition = SERVO_LEFT;     sprinkler.write(servoPosition); 
  } 
} 
BLYNK_WRITE(VP_CENTER) { 
  if (!autoMode && param.asInt()) {     servoPosition = SERVO_CENTER; 
    sprinkler.write(servoPosition); 
  } 
} 
BLYNK_WRITE(VP_RIGHT) { 
  if (!autoMode && param.asInt()) {     servoPosition = SERVO_RIGHT;     sprinkler.write(servoPosition); 
  } 
} 
 
// -------- Auto / Manual Mode -------- 
BLYNK_WRITE(VP_MODE) { 
  autoMode = param.asInt(); 
  Serial.print("MODE: "); 
  Serial.println(autoMode ? "AUTO" : "MANUAL"); 
} 
// -------- Auto Direction Sweep -------- 
void autoSweep() { 
  static int step = 0; 
int positions[] = {SERVO_LEFT, SERVO_CENTER, SERVO_RIGHT}; 
  sprinkler.write(positions[step]);   step = (step + 1) % 3; 
} 
// -------- Main Logic -------- void
sprinklerControl() { int soil = digitalRead(SOIL_PIN);   bool soilDry = (soil == HIGH);   if (autoMode) {     if (soilDry) { 
      digitalWrite(RELAY_PIN, LOW);       autoSweep();   // change direction 
    } else { 
      digitalWrite(RELAY_PIN, HIGH); 
    }   } else { 
    digitalWrite(RELAY_PIN, manualPump); 
  } 
  // -------- Serial Monitor -------- 
  Serial.print("Soil: "); 
  Serial.print(soilDry ? "DRY" : "WET"); 
  Serial.print(" | Pump: "); 
  Serial.print(digitalRead(RELAY_PIN) ? "OFF" : "ON"); 
  Serial.print(" | Servo Angle: "); 
  Serial.print(sprinkler.read()); 
  Serial.print(" | Mode: "); 
  Serial.println(autoMode ? "AUTO" : "MANUAL"); 
Blynk.virtualWrite(VP_SOIL, soil); 
} 
// -------- Setup -------- void setup() {   Serial.begin(115200);  pinMode(SOIL_PIN, INPUT);   pinMode(RELAY_PIN, OUTPUT); digitalWrite(RELAY_PIN, LOW);   sprinkler.attach(SERVO_PIN);   sprinkler.write(SERVO_CENTER); 
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass); 
  timer.setInterval(3000L, sprinklerControl); // direction changes every 3 sec 
} 
// -------- Loop -------- void loop() {   Blynk.run();   timer.run(); 
} 
